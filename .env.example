TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SCAN_INTERVAL_MINUTES=5
BANKROLL_RUB=10000
MIN_PROFIT_PERCENT=5
TIMEZONE=UTC+5
DATE_FORMAT=%d/%m
DATABASE_URL=sqlite:///odds_monitor.db
MODE=monitoring_only

ENABLE_ONLY_LIQUID_SPORTS=true
SKIP_LOW_LIQUIDITY_MARKETS=true
SPORT_WHITELIST=football,hockey,basketball,tennis,volleyball,mma,boxing,cs,dota2,lol,valorant
SPORT_BLACKLIST=chess,virtual_sport,cyberfootball,cyberbasketball,table_tennis_low_tier,unknown_low_liquidity_sports

TEAM_MATCH_THRESHOLD=88
LEAGUE_MATCH_THRESHOLD=80
MAX_START_TIME_DIFF_MINUTES=10
RESEND_AFTER_MINUTES=60
PROFIT_CHANGE_THRESHOLD_PERCENT=0.5

# Set these only for legal public JSON endpoints that do not require auth or bypassing protection.
# FONBET_API_URL may point to a public FONBET event endpoint like:
# https://line-.../ma/events/event?lang=ru&version=0&eventId=...&scopeMarket=1600
FONBET_API_URL=
WINLINE_API_URL=

# Local demo mode. Use `python main.py --once --sample` for a full dry run.
USE_SAMPLE_DATA=false
